{
    "name": "FamilyBoard",
    "short_name": "FamilyBoard",
    "description": "Tableau de bord familial - calendrier, tâches, chat et plus",
    "id": "/",
    "start_url": "/",
    "scope": "/",
    "display": "standalone",
    "launch_handler": { "client_mode": "navigate-existing" },
    "background_color": "#F4F2FB",
    "theme_color": "#7C5CFF",
    "lang": "fr",
    "icons": [
        {
            "src": "/public/icons/icon.svg",
            "sizes": "any",
            "type": "image/svg+xml",
            "purpose": "any maskable"
        },
        {
            "src": "/public/icons/icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/public/icons/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "/public/icons/icon-monochrome.svg",
            "sizes": "any",
            "type": "image/svg+xml",
            "purpose": "monochrome"
        }
    ],
    "shortcuts": [
        {
            "name": "Calendrier",
            "url": "/calendar",
            "icons": [{ "src": "/public/icons/icon.svg", "sizes": "any" }]
        },
        {
            "name": "Tâches",
            "url": "/tasks",
            "icons": [{ "src": "/public/icons/icon.svg", "sizes": "any" }]
        }
    ],
    "categories": ["productivity", "lifestyle"],
    "share_target": {
        "action": "/share-target",
        "method": "POST",
        "enctype": "multipart/form-data",
        "params": {
            "title": "title",
            "text": "text",
            "url": "url",
            "files": [
                { "name": "file", "accept": ["image/*", "application/pdf", ".doc", ".docx"] }
            ]
        }
    }
}
