Options -Indexes
RewriteEngine On

# Force HTTPS - NE PAS ACTIVER si vous utilisez un reverse proxy (Nginx Proxy Manager, Traefik...)
# Le reverse proxy gère le SSL, Apache reçoit du HTTP en interne.
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Serve existing files directly (CSS, JS, images, uploads)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Send all other requests to index.php
RewriteRule ^ index.php [L]
